# 数据库存储（默认内置 Node 22 SQLite 零配置运行；PocketBay 部署时自动挂载 POCKETBAY_DATA_DIR=/data 持久化卷）
SQLITE_DB_PATH="./data/zhizhaocesuo.db"
# POCKETBAY_DATA_DIR="/data"

# 认证密钥（至少32位随机字符串）
AUTH_SECRET="replace-with-a-random-secret-at-least-32-chars"

# 高德地图（Web端 JS API / Web服务 Key）
NEXT_PUBLIC_AMAP_KEY="your-amap-key"
NEXT_PUBLIC_AMAP_SECURITY_CODE=""
AMAP_SERVER_KEY="your-amap-server-key"

# 腾讯地图（JavaScript API GL / WebService Key）
NEXT_PUBLIC_TMAP_KEY="your-tencent-map-key"
TMAP_SERVER_KEY="your-tencent-map-key"

# 阿里云 OSS（可选；未配置时自动使用本地/PocketBay 持久化目录存储上传照片）
OSS_REGION=""
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_BUCKET=""
