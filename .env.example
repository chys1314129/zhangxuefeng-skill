# 数据库存储（默认内置 Node 22 SQLite 零配置运行；PocketBay 部署时自动挂载 POCKETBAY_DATA_DIR=/data 持久化卷）
SQLITE_DB_PATH="./data/zhizhaocesuo.db"
# POCKETBAY_DATA_DIR="/data"

# 认证密钥（至少32位随机字符串）
AUTH_SECRET="replace-with-a-random-secret-at-least-32-chars"

# 高德地图纯后端私有 Key（100% 隐藏于服务端，绝不暴露至浏览器前端；支持逗号分隔配置多个备用 Key 自动轮询容灾）
AMAP_SERVER_KEY="your-amap-web-service-key"
# 全站共享街区冷却缓存时长（小时，默认 24 小时内同一街区所有访客共享本地数据库结果，0 重复高德搜索消耗）
AMAP_SYNC_COOLDOWN_HOURS="24"

# 阿里云 OSS（可选；未配置时自动使用本地/PocketBay 持久化目录存储上传照片）
OSS_REGION=""
OSS_ACCESS_KEY_ID=""
OSS_ACCESS_KEY_SECRET=""
OSS_BUCKET=""
